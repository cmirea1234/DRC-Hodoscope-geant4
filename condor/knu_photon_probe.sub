universe = vanilla
executable = /u/user/chjoung/DRC-Hodoscope-geant4/scripts/knu_photon_probe.sh
arguments = $(ClusterId) $(ProcId)
initialdir = /u/user/chjoung/DRC-Hodoscope-geant4
should_transfer_files = NO
getenv = False
request_cpus = 1
request_memory = 4 GB
request_disk = 4 GB
requirements = (OpSysAndVer == "AlmaLinux9") && (TARGET.FileSystemDomain == "knu.ac.kr")
log = runs/knu_diagnostic_20261029/photon.$(ClusterId).log
output = runs/knu_diagnostic_20261029/photon.$(ClusterId).$(ProcId).out
error = runs/knu_diagnostic_20261029/photon.$(ClusterId).$(ProcId).err
notification = Never
periodic_hold = (JobStatus == 2) && ((CurrentTime - JobCurrentStartExecutingDate) > 14400)
on_exit_hold = (ExitBySignal == True) || (ExitCode != 0)
queue 1
